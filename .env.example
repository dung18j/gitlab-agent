# =============================================================================
# agent-runner configuration
# Copy to .env and fill in. Everything here is optional except the token.
# =============================================================================

# --- GitLab ------------------------------------------------------------------
# Personal access token with the `api` scope (add `read_repository` to clone).
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# Or use GITLAB_PAT instead; the script maps it to GITLAB_TOKEN.
#GITLAB_PAT=glpat-xxxxxxxxxxxxxxxxxxxx
# GitLab instance. Accepts a bare host, a host with a scheme, or a full API URL
# via GITLAB_API_URL. For self-hosted plain HTTP on a custom port, include the
# scheme (simplest), or set a bare host plus the protocol:
#   GITLAB_HOST=http://10.10.1.1:8080
#   GITLAB_HOST=10.10.1.1:8080        + GLAB_API_PROTOCOL=http
GITLAB_HOST=gitlab.com
# Protocol for API and clone URLs. Derived from the host/URL above; set it
# explicitly when the host has no scheme. Use http for plain-HTTP instances.
GLAB_API_PROTOCOL=https

# --- polling / claiming ------------------------------------------------------
# Seconds between polls when there is nothing to do.
POLL_INTERVAL=30
# Seconds to wait after posting a claim before checking who claimed first.
CLAIM_WAIT_SECONDS=5
# Hidden marker used to recognise claim notes. Claims are scoped to a request
# (comment) id, so the same marker can be shared by all containers on a queue.
CLAIM_MARKER=opencode-agent-claim
# Emoji reaction added as a visible marker once a request is claimed. The
# request-scoped claim note is what prevents reprocessing. Use "none" to disable.
CLAIM_REACTION=eyes
# Friendly name shown in notes.
AGENT_NAME=opencode-agent
# Claim note text; the request id and hidden marker are appended automatically.
#CLAIM_MESSAGE=🤖 ${AGENT_NAME} is claiming this task

# --- OpenCode ----------------------------------------------------------------
# Provider credential. OPENCODE_API_KEY is used by the OpenCode Console
# provider; other providers use their own variable, e.g. ANTHROPIC_API_KEY,
# OPENAI_API_KEY, OPENROUTER_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY.
OPENCODE_API_KEY=
# Model as provider/model (leave empty to use OpenCode's configured default).
#OPENCODE_MODEL=opencode/grok-code
# Optional OpenCode agent and extra CLI flags (whitespace separated).
#OPENCODE_AGENT=build
#OPENCODE_ARGS=--standalone --log-level info
# Abort an opencode run after this many seconds (0 = no limit).
OPENCODE_TIMEOUT=0

# --- request handling --------------------------------------------------------
# Action used when the request body does not start with a known action word.
DEFAULT_ACTION=implement
# Actions recognised at the start of a request.
AGENT_ACTIONS=implement explain review plan fix test refactor document analyze describe
# Only process these GitLab todo action_names (empty = all).
# Example: mentioned,assigned,directly_addressed,review_requested
TODO_ACTIONS=
# Only handle todos from these projects: comma-separated paths (group/project)
# or numeric project ids. Empty = every project.
ALLOWED_PROJECTS=
# Only handle todos requested by these usernames or numeric user ids.
# Empty = every requester.
ALLOWED_REQUESTERS=
# Also post opencode's raw output as a note (the agent posts its own reply).
POST_RESULT=false
RESULT_MAX_CHARS=60000

# --- workspace ---------------------------------------------------------------
WORKDIR=/workspace
# Clone the target project before running opencode (needed for implement/fix).
CLONE_REPO=false
#CLONE_DIR=/workspace/repos/my-project
# Branch name is this prefix plus the request id, e.g. agent/note_123.
MR_BRANCH_PREFIX=agent/
# Target branch of the merge request; empty uses the project default branch.
#MR_TARGET_BRANCH=main
# Marker prefixed to every GitLab note the agent posts.
REPLY_MARKER=🤖 opencode-agent
# Extra instructions appended to the built-in prompt.
#EXTRA_PROMPT=

# --- misc --------------------------------------------------------------------
# Dry run: log what would be claimed/run without touching GitLab or opencode.
DRY_RUN=false
#ENV_FILE=/app/.env

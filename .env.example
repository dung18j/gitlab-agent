# Copy to .env and fill in:
#     cp .env.example .env
#
# .env is git-ignored and never written into the image. Pass it to the
# container with `podman run --env-file .env ...`.

# --- GitLab access (required) ------------------------------------------------
# Personal access token with the `api` and `write_repository` scopes: `api` to
# read/react/reply, `write_repository` to clone and push over HTTPS. Create one
# under User Settings -> Access tokens. `GITLAB_TOKEN` is accepted as an
# alternative name.
GITLAB_PERSONAL_ACCESS_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# GitLab API base URL. Change this for a self-hosted instance,
# e.g. https://gitlab.example.com/api/v4
# The bot derives GITLAB_HOST and the API/git protocol from this.
GITLAB_API_URL=https://gitlab.com/api/v4

# --- Model provider credentials (set the one you use) -----------------------
# OpenCode reads these directly from the environment.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
#OPENCODE_API_KEY=

# Optional: default model, in "<provider>/<model>" form.
#OPENCODE_MODEL=anthropic/claude-sonnet-4-5

# --- gitlab-agent bot (optional) --------------------------------------------
# Only handle to-dos from these projects, by ID or `group/project` path
# (comma-separated). Empty = all projects.
#PROJECTS=aiot-tech/aiot-gateway,dune/a
# Only handle to-dos authored by these GitLab usernames (comma-separated).
# Empty = any author. Case-insensitive.
#AUTHORS=dune
# Directory OpenCode runs in (mounted or ephemeral inside the container).
#WORKSPACE=/workspace
# Seconds between sweeps.
#INTERVAL=60
# Kill an OpenCode run after this many seconds.
#TIMEOUT=3600
# Maximum to-dos handled per sweep.
#MAX=1
# Ignore to-dos authored by the bot account itself (default: true).
#IGNORE_SELF=true
# Mark the to-do done after handling it (default: true).
#MARK_TODO=true
# Reaction used as the handled marker.
#EMOJI=eyes
# First line of the agent's reply.
#REPLY_MARKER=🤖
# Extra instructions appended to every prompt. Use \n for line breaks.
#EXTRA_PROMPT=Always reply in English.
